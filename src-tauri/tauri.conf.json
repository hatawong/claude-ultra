{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Ultra",
  "version": "1.2.118",
  "identifier": "com.claude-ultra.manager",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxMzNERjhBQjZBOUI3RTQKUldUa3Q2bTJpdDh6Z1ZaWXdkM3FPdjhLdGhsUldrcVhDR1Z6KzQrYk15dzY1M3ZuL1JLaFNQWjkK",
      "endpoints": [
        "https://github.com/hatawong/claude-ultra/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ]
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Claude Ultra",
        "width": 1120,
        "height": 700,
        "minWidth": 1120,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src ipc: http://ipc.localhost"
    }
  }
}